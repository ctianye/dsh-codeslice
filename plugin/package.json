{
  "name": "dsh-codeslice",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Read a codebase as a graph: an AST knowledge graph with calls, inheritance and rationale, symbol navigation, keyword retrieval over Chinese and English, and a note knowledge base with anchor drift detection — beside the conversation.",
  "icon": "icon.svg",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client/editor.js",
    "client/vendor/**",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "WIRE.md",
    "WIRE-CHAT.md",
    "INTERFACES-v3.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "code-graph",
    "call-graph",
    "symbols",
    "code-reading",
    "knowledge-graph",
    "code-notes"
  ],
  "license": "MIT",
  "scripts": {
    "build:client": "node dev/build-client.mjs",
    "build:editor": "node dev/build-editor.mjs"
  }
}
